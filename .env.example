# ==============================================================================
# CF TECH · FATOS RELEVANTES CVM · CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# Porta da Aplicação Web (Padrão: 8001 ou atribuída automaticamente na nuvem)
PORT=8001

# Chave de Inteligência Artificial Google Gemini (Google AI Studio)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# ALERTAS DE WHATSAPP (Opcional - Modo Simulação e Link Web wa.me ativo por padrão)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=simulacao

# Se optar por usar a Z-API (https://z-api.io):
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Se optar por usar a Evolution API (Docker local/nuvem):
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=cftech

# Se optar por usar o Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# ALERTAS DO TELEGRAM (Opcional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALERTAS=

